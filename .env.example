# Pooled connection string — used by the app at runtime
DATABASE_URL=

# Direct (non-pooled) connection string — used by prisma migrate and seed
# Connection poolers don't support the session-level SQL that migrations need
DIRECT_URL=

# First admin account, read by `npm run seed` (or `npx prisma db seed`)
# Password must be at least 8 characters
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Must be two different random strings (reusing one is a security hole)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Allowed CORS origin. Comma-separate for multiple, no trailing slash
FRONTEND_URL=http://localhost:5173

# strict | lax | none — use "none" only if API and frontend are on different domains
COOKIE_SAME_SITE=strict

# development | production
NODE_ENV=development