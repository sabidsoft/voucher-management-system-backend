generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(OPERATOR)

  isActive  Boolean   @default(true)

  sessions  Session[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Session {
  id               String   @id @default(cuid())

  refreshTokenHash String   @unique

  // Recent-hash history for the grace-period pattern: when the refresh
  // token rotates, the OLD hash is pushed here (with its own short
  // expiry) instead of being discarded immediately. A burst of several
  // near-simultaneous requests (e.g. mashing reload rapidly) can each
  // still validate against a recent-enough entry here, instead of being
  // treated as token theft and wiping every session for the user.
  // Shape: [{ "hash": string, "expiresAt": ISO string }, ...]
  previousHashes   Json?

  deviceInfo       String?
  ipAddress        String?

  expiresAt        DateTime

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId           String
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}